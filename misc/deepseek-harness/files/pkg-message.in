[
{ type: install
  message: <<EOM
DeepSeek Harness (dsh) has been installed.

CLI usage:
  dsh --help
  dsh web --no-open

To enable and start the Web UI service:
  sysrc dsh_web_enable="YES"
  service dsh_web start

By default, dsh_web listens on http://127.0.0.1:3080 with
DSH_HOME=/var/db/dsh and logs to /var/log/dsh_web.log.
See %%PREFIX%%/etc/rc.d/dsh_web for tunable rc.conf variables.
EOM
}
]
