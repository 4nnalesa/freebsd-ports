#!/bin/sh

# PROVIDE: dsh_web
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable dsh_web:
#
# dsh_web_enable (bool):	Set to "YES" to enable dsh_web.
#				Default: "NO"
# dsh_web_user (str):		User to run dsh_web as.
#				Default: "www"
# dsh_web_group (str):		Group to run dsh_web as.
#				Default: "www"
# dsh_web_chdir (str):		Working directory and DSH_HOME for dsh_web.
#				Default: "/var/db/dsh"
# dsh_web_host (str):		Concrete IPv4 or IPv6 address to bind.
#				Default: "127.0.0.1"
# dsh_web_port (str):		TCP port to listen on.
#				Default: "3080"
# dsh_web_log (str):		Path to the log file.
#				Default: "/var/log/dsh_web.log"
# dsh_web_max_old_space_size (str):
#				V8 max old-space heap size in MiB (empty to unset).
#				Default: "4096"
# dsh_web_flags (str):		Extra flags passed to "dsh web".
#				Default: ""

. /etc/rc.subr

name="dsh_web"
rcvar="dsh_web_enable"

load_rc_config "${name}"

: ${dsh_web_enable:="NO"}
: ${dsh_web_user:="www"}
: ${dsh_web_group:="www"}
: ${dsh_web_chdir:="/var/db/dsh"}
: ${dsh_web_host:="127.0.0.1"}
: ${dsh_web_port:="3080"}
: ${dsh_web_log:="/var/log/dsh_web.log"}
: ${dsh_web_max_old_space_size:="4096"}
: ${dsh_web_flags:=""}

pidfile="/var/run/${name}.pid"
procname="%%LOCALBASE%%/bin/node"
command="/usr/sbin/daemon"
command_args="-f -H -p ${pidfile} -o ${dsh_web_log} -t ${name} \
	%%PREFIX%%/bin/dsh web --no-open \
	--host ${dsh_web_host} --port ${dsh_web_port} ${dsh_web_flags}"

start_precmd="${name}_prestart"

dsh_web_prestart()
{
	install -d -o "${dsh_web_user}" -g "${dsh_web_group}" -m 0750 \
		"${dsh_web_chdir}" "${dsh_web_chdir}/tmp"
	install -o "${dsh_web_user}" -g "${dsh_web_group}" -m 0644 \
		/dev/null "${pidfile}"
	if [ ! -e "${dsh_web_log}" ]; then
		install -o "${dsh_web_user}" -g "${dsh_web_group}" -m 0640 \
			/dev/null "${dsh_web_log}"
	fi

	export PATH="%%PREFIX%%/bin:%%LOCALBASE%%/bin:${PATH}"
	export HOME="${dsh_web_chdir}"
	export DSH_HOME="${dsh_web_chdir}"
	export TMPDIR="${dsh_web_chdir}/tmp"

	if [ -n "${dsh_web_max_old_space_size}" ]; then
		export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--max-old-space-size=${dsh_web_max_old_space_size}"
	fi
}

run_rc_command "$1"
