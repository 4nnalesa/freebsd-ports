#!/bin/sh

# PROVIDE: sillytavern
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable sillytavern:
#
# sillytavern_enable (bool):   Set to NO by default.
#                              Set it to YES to enable sillytavern.
# sillytavern_user (str):      User to run sillytavern as.
#                              Default: %%USERS%%
# sillytavern_group (str):     Group to run sillytavern as.
#                              Default: %%GROUPS%%
# sillytavern_node (str):      Path to Node.js binary.
#                              Default: %%LOCALBASE%%/bin/node
# sillytavern_chdir (str):     Application directory.
#                              Default: %%WWWDIR%%
# sillytavern_config (str):    Path to config.yaml.
#                              Default: %%ETCDIR%%/config.yaml
# sillytavern_datadir (str):   Directory for user data.
#                              Default: %%DBDIR%%
# sillytavern_log (str):       Service output log file.
#                              Default: /var/log/sillytavern.log
# sillytavern_env (str):       Environment variables for Node.js.
# sillytavern_flags (str):     Extra arguments passed to server.js.
#                              Default: ""
#
# The listen address and port come from config.yaml (shipped with
# "listen: false", so the default is 127.0.0.1:8000).

. /etc/rc.subr

name="sillytavern"
rcvar="sillytavern_enable"

load_rc_config $name

: ${sillytavern_enable:="NO"}
: ${sillytavern_user:="%%USERS%%"}
: ${sillytavern_group:="%%GROUPS%%"}
: ${sillytavern_node:="%%LOCALBASE%%/bin/node"}
: ${sillytavern_chdir:="%%WWWDIR%%"}
: ${sillytavern_config:="%%ETCDIR%%/config.yaml"}
: ${sillytavern_datadir:="%%DBDIR%%"}
: ${sillytavern_log:="/var/log/sillytavern.log"}
: ${sillytavern_flags:=""}
: ${sillytavern_env:="NODE_ENV=production HOME=${sillytavern_datadir} PATH=/sbin:/bin:/usr/sbin:/usr/bin:%%LOCALBASE%%/sbin:%%LOCALBASE%%/bin"}

pidfile="/var/run/${name}/${name}.pid"
procname="${sillytavern_node}"
required_dirs="${sillytavern_chdir}"
required_files="${sillytavern_config} ${sillytavern_chdir}/server.js"

command="/usr/sbin/daemon"
command_args="-f -H -t ${name} -p ${pidfile} -o ${sillytavern_log} \
	${procname} ${sillytavern_chdir}/server.js \
	--configPath ${sillytavern_config} \
	--dataRoot ${sillytavern_datadir} \
	${sillytavern_flags}"

start_precmd="sillytavern_precmd"

sillytavern_precmd()
{
	[ -x "${procname}" ] \
		|| err 1 "${procname} is not executable"
	install -d -o "${sillytavern_user}" -g "${sillytavern_group}" -m 0750 \
		"/var/run/${name}" "${sillytavern_datadir}"
	if [ -f "${sillytavern_log}" ]; then
		/usr/sbin/chown "${sillytavern_user}:${sillytavern_group}" "${sillytavern_log}"
	else
		install -o "${sillytavern_user}" -g "${sillytavern_group}" -m 0640 \
			/dev/null "${sillytavern_log}"
	fi
	rc_flags=""
}

run_rc_command "$1"
